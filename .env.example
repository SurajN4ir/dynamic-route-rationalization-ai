# Copy this file to .env and adjust as needed for local development.
# .env is gitignored - never commit real secrets (see
# docs/architecture/02-non-functional-requirements.md 2.5).
#
# docker-compose.yml sets DATABASE_URL/REDIS_URL itself for the `api`
# service (pointing at the `postgres`/`redis` service names), so these
# values only matter when running the API directly on the host.

# --- services/api ---
APP_NAME=AURA API
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://aura:aura_dev_password@localhost:5432/aura
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- docker-compose postgres service ---
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
