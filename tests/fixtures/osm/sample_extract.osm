<?xml version='1.0' encoding='UTF-8'?>
<!--
  Deterministic, hand-built OSM XML fixture for AURA ingestion tests.
  NOT real-world data - a small synthetic network designed to exercise:
    - way splitting at a shared junction node (N2, used by way 100 AND way 200)
    - a bidirectional road (way 100)
    - a one-way road, forward (way 200, oneway=yes)
    - a one-way road, reverse (way 700, oneway=-1)
    - road names (for Road grouping) and optional maxspeed/lanes
    - an unsupported highway value, rejected (way 300, highway=footway)
    - a malformed way with too few nodes, rejected (way 400)
    - a way referencing a nonexistent node, rejected (way 500)
  See docs/architecture/TASK202_DESIGN.md §13 for the full test-coverage
  rationale.
-->
<osm version="0.6" generator="AURA-test-fixture">
  <node id="1" lat="12.9700" lon="77.5900" version="1"/>
  <node id="2" lat="12.9710" lon="77.5900" version="1"/>
  <node id="3" lat="12.9720" lon="77.5900" version="1"/>
  <node id="4" lat="12.9710" lon="77.5910" version="1"/>
  <node id="5" lat="12.9730" lon="77.5900" version="1"/>
  <node id="6" lat="12.9740" lon="77.5850" version="1"/>
  <node id="7" lat="12.9745" lon="77.5850" version="1"/>

  <!-- bidirectional road, split at node 2 (shared with way 200) -->
  <way id="100" version="1">
    <nd ref="1"/>
    <nd ref="2"/>
    <nd ref="3"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Test Main Street"/>
    <tag k="maxspeed" v="40"/>
    <tag k="lanes" v="2"/>
  </way>

  <!-- one-way (forward), branches off the shared node -->
  <way id="200" version="1">
    <nd ref="2"/>
    <nd ref="4"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Test Cross Street"/>
    <tag k="oneway" v="yes"/>
  </way>

  <!-- unsupported highway value - must be rejected, not ingested -->
  <way id="300" version="1">
    <nd ref="3"/>
    <nd ref="5"/>
    <tag k="highway" v="footway"/>
    <tag k="name" v="Test Footpath"/>
  </way>

  <!-- malformed: only one node reference - must be rejected -->
  <way id="400" version="1">
    <nd ref="1"/>
    <tag k="highway" v="residential"/>
  </way>

  <!-- malformed: references a node id not present in this extract -->
  <way id="500" version="1">
    <nd ref="3"/>
    <nd ref="999"/>
    <tag k="highway" v="residential"/>
  </way>

  <!-- one-way (reverse) - allowed travel direction is node 7 -> node 6 -->
  <way id="700" version="1">
    <nd ref="6"/>
    <nd ref="7"/>
    <tag k="highway" v="tertiary"/>
    <tag k="name" v="Test Reverse Road"/>
    <tag k="oneway" v="-1"/>
  </way>
</osm>
